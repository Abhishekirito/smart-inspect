# Environment Variables Template
# Copy this file to .env and fill in your API keys.

# Google Cloud Vision API Key (for OCR & bounding box extraction)
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Groq API Key & Model (for structuring extracted label text into JSON)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=groq/compound

# OCR.space API Key (optional fallback OCR engine)
VITE_OCR_SPACE_API_KEY=helloworld

# Google Gemini API Key (optional fallback LLM engine)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (authentication + database) — REQUIRED for login and cloud storage.
# Find these in your Supabase dashboard under Project Settings → API.
# The anon/public key is designed to be used in browsers; keep the service_role key secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
